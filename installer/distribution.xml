<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>NoSleep</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="LICENSE.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <background file="background.png" mime-type="image/png" alignment="bottomleft" scaling="proportional"/>
    <background-darkAqua file="background-dark.png" mime-type="image/png" alignment="bottomleft" scaling="proportional"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.nosleep.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.nosleep.pkg" visible="false">
        <pkg-ref id="com.nosleep.pkg"/>
    </choice>
    <pkg-ref id="com.nosleep.pkg" version="1.1.6" onConclusion="none">NoSleep-component.pkg</pkg-ref>
</installer-gui-script>
